# Set these in your shell before starting; no dotenv dependency.
PORT=5173
STUDIO_STORAGE=./storage
# Coding agents use their own installed authentication; no keys belong here.
# Optional: serve read-only prototype share links on this port (exposes only approved prototype bundles).
# STUDIO_SHARE_PORT=5180
# STUDIO_SHARE_HOST=0.0.0.0
# Optional: number of concurrent jobs (default 3).
# STUDIO_MAX_JOBS=3
